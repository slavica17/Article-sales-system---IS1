<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence           http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
  <persistence-unit name="Podsistem3PU" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <class>entiteti.Narudzbina</class>
    <class>entiteti.Stavka</class>
    <class>entiteti.Transakcija</class>
    <class>entiteti.Artikal</class>
    <class>entiteti.Korisnik</class>
    <properties>
      <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/podsistem3_db?zeroDateTimeBehavior=CONVERT_TO_NULL&amp;serverTimezone=Europe/Belgrade"/>
      <property name="javax.persistence.jdbc.user" value="root"/>
      <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="javax.persistence.jdbc.password" value="root123"/>
    </properties>
  </persistence-unit>
</persistence>
